# Copy to .env (never commit it). In cloud sessions, set these as environment secrets instead.

# Claude API - refactor/planning engine. Optional if you use `ant auth login`.
ANTHROPIC_API_KEY=
FACTORY_MODEL=claude-opus-5-5

# GitHub read-only token (public_repo read). Raises search limit from 10 to 30 req/min.
FACTORY_GITHUB_TOKEN=

# Scanner tuning
SCAN_MIN_STARS=300
SCAN_ABANDONED_MONTHS=24
SCAN_LANGUAGES=JavaScript,Python,TypeScript,Go,Ruby,PHP
SCAN_MAX_RESULTS_PER_LANGUAGE=30

# Storage
FACTORY_DB_PATH=./data/factory.db

# Billing (stage 3 - not wired yet). Use test keys only until launch.
BILLING_PROVIDER=stripe   # stripe | toss
STRIPE_SECRET_KEY=
TOSS_SECRET_KEY=

# Publishing (stage 3 - dry-run unless set to false)
PUBLISH_DRY_RUN=true
